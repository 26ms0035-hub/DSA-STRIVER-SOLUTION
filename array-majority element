class Solution {
public:
    int majorityElement(vector<int>& nums) {
int candt=nums[0];
int n=nums.size();
int count=0;
for(int j=0;j<n;j++){
    if(count==0){
        candt=nums[j];
    }

    if(nums[j]==candt){
count++;
    }
    if(nums[j]!=candt){
        count--;
    }
    
}   
return candt;
    }

};
