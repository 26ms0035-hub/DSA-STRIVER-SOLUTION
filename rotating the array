lass Solution {
public:
    void rotateArray(vector<int>& nums, int k) {
        int n=nums.size();
        if(k<n){int j=0;
            while( j<k){
               int temp=nums[0];
                for(int i=0;i<n-1;i++){
                    nums[i]=nums[i+1];
                }
                nums[n-1]=temp;
                j++;
            }
        }

   else{int j=0;
    while( j<k%n){
        int temp=nums[0];
    for(int i=0;i<n-1;i++){
        nums[i]=nums[i+1];
    }
    nums[n-1]=temp;
    j++;
   }

   }     
        


    }
};
