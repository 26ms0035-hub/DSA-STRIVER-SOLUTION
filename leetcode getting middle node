
class Solution {
    private:
    int getlength(ListNode* head){
        int n=0;
        ListNode*temp=head;
        while(temp!=NULL){
            n++;
            temp=temp->next;
        }
        return n;
    }
public:
    ListNode* middleNode(ListNode* head) {
        ListNode*temp=head;
        int n=getlength(head);
            int j=0;
            while(j<(n/2)){
                temp=temp->next;
                j++;
            }
        return temp;

        
        
    }
};
