class Solution {
public:
    vector<int> intersectionArray(vector<int>& nums1, vector<int>& nums2) {
        
        int n=nums1.size();
        int m=nums2.size();
        vector<int> a;
        int i=0;
        int j=0;
        if(n==0 || m==0){
            return a;
        }
        while(i<n && j<m){
            if(nums1[i]==nums2[j]){
                a.push_back(nums1[i]);
                i++;
                j++;
            }
            else if(nums1[i]>nums2[j]){
                j++;
            
            }
           else if(nums2[j]>nums1[i]){
                i++;
            }

        }
        return a;
    }
};
