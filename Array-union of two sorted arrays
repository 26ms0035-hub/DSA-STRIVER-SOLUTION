class Solution {
public:
    vector<int> unionArray(vector<int>& nums1, vector<int>& nums2) {
        int n=nums1.size();
        int m=nums2.size();
        int i=0;
        int j=0;
        int k=0;
        vector <int>nums3;
            while(i<n && j<m){
                if(k==0){
                    if(nums1[i]>nums2[j]){
                        nums3.push_back(nums2[j]);
                        j++;
                    }
                     else if(nums1[i]<nums2[j]){
                        nums3.push_back(nums1[i]);
                        i++;
                    }

                    else if(nums1[i]==nums2[j]){
                        nums3.push_back(nums2[j]);
                        i++;j++;
                    }
                    k++;
                }

                else{
                    if(nums1[i]<nums2[j] && nums3[k-1]!=nums1[i]){
                       nums3.push_back (nums1[i]);
                        i++;
                        k++;
                    }
                   else if(nums1[i]<nums2[j] && nums3[k-1]==nums1[i]){
                        i++;
                    }

                  else  if(nums1[i]>nums2[j] && nums3[k-1]!=nums2[j]){
                        
                        nums3.push_back(nums2[j]);
                        j++;
                        k++;
                    }
                    else  if(nums1[i]>nums2[j] && nums3[k-1]==nums2[j]){
                        j++;
                    }
                    else if(nums1[i]==nums2[j]){
                    if(nums3[k-1]!=nums1[i]){
                        nums3.push_back(nums2[j]);
                        i++;j++;k++;
                    }
                    else{i++;j++;}
                }

                }

            }
            while(i<n){

                if( nums3[k-1]!=nums1[i]){
                    nums3.push_back(nums1[i]);
                    i++;
                    k++;

                }
                else{i++;}
            }
            while(j<m){
                if( nums3[k-1]!=nums2[j]){
                    
                    nums3.push_back(nums2[j]);
                    j++;
                    k++;

                }
                else{j++;}
            }
                
        
    return nums3;
    }

};
