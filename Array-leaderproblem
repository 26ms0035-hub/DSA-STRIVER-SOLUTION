# Approach one-but exceeding time limit on one case(geeksofgeeks)
why-?-repeated task which consuming time
vector<int> leaders(vector<int>& arr) {
        // code here
        int i=0;
               int j=1;
               int n=arr.size();
               vector<int>nums;
               while(i<j && i<n-1 ){
                   if(arr[i]<arr[j]){
                       i++;
                       j=i;
                   }
                   else if(arr[i]>=arr[j]){
                       if(j==n-1){
                           nums.push_back(arr[i]);
                           i++;
                           j=i;
                       }
                   }
                   j++;
               }
               nums.push_back(arr[n-1]);
               return nums;


           }
# Approach 2-efficient due to we remove the repeated operation of traversing 
previous element.by preserving previous information.
vector<int> leaders(vector<int>& arr) {
        // code here
        vector<int>nums;
        int n=arr.size();
        int currmax=arr[n-1];
        int j=n-2;
    nums.push_back(arr[n-1]);
        while(j>=0){
            if(arr[j]>=currmax){
                nums.push_back(arr[j]);
                currmax=arr[j];
            }
            j--;
        }
        reverse(nums.begin(),nums.end());
        return nums;
        
    }
    
